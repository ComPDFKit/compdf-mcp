# Each MCP request supplies its user's ComPDF API Key through the
# X-ComPDF-API-Key HTTP header. Do not configure a shared COMPDF_API_KEY here.

# Use the China mainland endpoint only when your ComPDF key belongs to that region.
COMPDF_API_BASE_URL=https://api-server.compdf.com/server
# COMPDF_API_BASE_URL=https://api-server.compdf.cn/server

# The synchronous PDF-to-Word API may take time for larger documents.
COMPDF_API_TIMEOUT_SECONDS=120

# Streaming HTTP MCP service settings.
MCP_HOST=0.0.0.0
MCP_PORT=8000
# Add the production reverse-proxy domain (including its port, if nonstandard)
# before deployment. ``:*`` accepts any port for a host.
MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,mcp.example.com
# Optional: comma-separated browser origins allowed by MCP transport security.
MCP_ALLOWED_ORIGINS=

# Production authentication. Create/rotate tokens in a secret manager, not in
# this file. Both URLs must be public HTTPS URLs when tokens are configured.
MCP_ENV=development
MCP_PUBLIC_URL=https://mcp.example.com
MCP_OAUTH_ISSUER_URL=https://auth.example.com
MCP_REQUIRED_SCOPES=compdf:invoke
# MCP_STATIC_TOKENS_JSON={"replace-with-a-secret":{"tenant_id":"tenant-a","scopes":["compdf:invoke"]}}

# Set to 0 only when a trusted external gateway performs rate limiting.
MCP_RATE_LIMIT_PER_MINUTE=120
